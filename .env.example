# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# Database connection string.
# Development default (SQLite, no server required):
DATABASE_URL=sqlite:///./app.db
# Example for PostgreSQL later:
# DATABASE_URL=postgresql://user:password@localhost:5432/energy_db

# JWT secret key -- KEEP THIS SECRET, use a long random value.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-value

# JWT signing algorithm.
ALGORITHM=HS256

# How long an access token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The React frontend's origin, used for CORS.
FRONTEND_URL=http://localhost:5173
